{
  "language": "zh",
  "segments": [
    {
      "start": 32.02,
      "end": 34.38,
      "text": "法拉松的视觉语言主要基于"
    },
    {
      "start": 34.38,
      "end": 37.06,
      "text": "邦纸提出的图形现实主义"
    },
    {
      "start": 37.06,
      "end": 39.54,
      "text": "这一概念融合了剪约有力的设计"
    },
    {
      "start": 39.54,
      "end": 42.46,
      "text": "与现实世界的真实质感"
    },
    {
      "start": 42.46,
      "end": 43.5,
      "text": "这种设计思路"
    },
    {
      "start": 43.5,
      "end": 45.98,
      "text": "惯穿了游戏的整个美学体系"
    },
    {
      "start": 47.22,
      "end": 50.14,
      "text": "营造出一种既有现实跟鸡"
    },
    {
      "start": 51.66,
      "end": 53.9,
      "text": "又不是风格化的艺术氛围"
    },
    {
      "start": 53.9,
      "end": 56.02,
      "text": "具体来说这里的图形"
    },
    {
      "start": 56.02,
      "end": 59.78,
      "text": "指的是经过检化与解构的设计元素"
    },
    {
      "start": 60.58,
      "end": 62.46,
      "text": "是一种具备强烈视觉"
    },
    {
      "start": 62.46,
      "end": 64.26,
      "text": "张立的通用设计语言"
    },
    {
      "start": 64.26,
      "end": 65.74,
      "text": "以有限的材质实现"
    },
    {
      "start": 65.74,
      "end": 67.3,
      "text": "鲜明的色彩表达"
    },
    {
      "start": 67.3,
      "end": 68.5,
      "text": "而现实主义部分"
    },
    {
      "start": 68.5,
      "end": 72.26,
      "text": "则只像他们利用比例与耻度"
    },
    {
      "start": 72.26,
      "end": 75.3,
      "text": "在写实的基调下暗示功能细节"
    },
    {
      "start": 75.3,
      "end": 76.14,
      "text": "剪而言之"
    },
    {
      "start": 76.14,
      "end": 78.22,
      "text": "图形现实主义呈现的是"
    },
    {
      "start": 78.22,
      "end": 81.02,
      "text": "现实中可见之物"
    },
    {
      "start": 81.02,
      "end": 84.26,
      "text": "却运用独特的色彩"
    },
    {
      "start": 84.26,
      "end": 86.06,
      "text": "材质与文立等手法"
    },
    {
      "start": 86.06,
      "end": 87.18,
      "text": "加以重速"
    },
    {
      "start": 87.18,
      "end": 88.94,
      "text": "它是点坠色对比度"
    },
    {
      "start": 88.94,
      "end": 90.94,
      "text": "与耻度感的精妙融合"
    },
    {
      "start": 91.94,
      "end": 93.02,
      "text": "马拉松的环境"
    },
    {
      "start": 93.02,
      "end": 94.5,
      "text": "道具及角色设计"
    },
    {
      "start": 95.42,
      "end": 97.62,
      "text": "军彩用极减视觉风格"
    },
    {
      "start": 97.62,
      "end": 99.1,
      "text": "确保每一处造型"
    },
    {
      "start": 99.1,
      "end": 100.9,
      "text": "都具备明确的功能指向"
    },
    {
      "start": 100.9,
      "end": 102.02,
      "text": "场景误解"
    },
    {
      "start": 102.02,
      "end": 103.38,
      "text": "并气了反复的细节"
    },
    {
      "start": 103.38,
      "end": 104.86,
      "text": "堆弃转而聚焦于"
    },
    {
      "start": 104.86,
      "end": 106.1,
      "text": "力落的轮廓"
    },
    {
      "start": 106.1,
      "end": 108.1,
      "text": "以及通透的形态"
    },
    {
      "start": 108.1,
      "end": 109.82,
      "text": "在消除视觉噪音的同时"
    },
    {
      "start": 109.82,
      "end": 111.3,
      "text": "精准传达功能"
    },
    {
      "start": 111.3,
      "end": 112.46,
      "text": "尤其在色彩运用上"
    },
    {
      "start": 112.46,
      "end": 113.14,
      "text": "极为克制"
    },
    {
      "start": 113.14,
      "end": 115.38,
      "text": "仅选用高保合度的农预色调"
    },
    {
      "start": 115.38,
      "end": 116.66,
      "text": "图形现实主义"
    },
    {
      "start": 116.66,
      "end": 117.46,
      "text": "推崇一种"
    },
    {
      "start": 117.46,
      "end": 118.62,
      "text": "视觉语言"
    },
    {
      "start": 118.62,
      "end": 120.78,
      "text": "它亲切且急剧辨识度"
    },
    {
      "start": 120.78,
      "end": 121.54,
      "text": "因此"
    },
    {
      "start": 121.54,
      "end": 123.06,
      "text": "这个世界标识"
    },
    {
      "start": 123.06,
      "end": 124.06,
      "text": "符号与物件"
    },
    {
      "start": 124.06,
      "end": 126.62,
      "text": "都具备直观而强烈的视觉张立"
    },
    {
      "start": 126.62,
      "end": 128.94,
      "text": "尊寻这一图形化设计理念"
    },
    {
      "start": 128.94,
      "end": 131.18,
      "text": "材质处理区域减化通过文立"
    },
    {
      "start": 131.18,
      "end": 133.62,
      "text": "模拟现实世界的质感"
    },
    {
      "start": 133.62,
      "end": 134.94,
      "text": "无论是金属"
    },
    {
      "start": 134.94,
      "end": 136.86,
      "text": "玻璃还是合成之物"
    },
    {
      "start": 136.86,
      "end": 138.5,
      "text": "他们兼具真实触感"
    },
    {
      "start": 138.5,
      "end": 139.82,
      "text": "与集结美学"
    },
    {
      "start": 139.82,
      "end": 140.62,
      "text": "在写实感"
    },
    {
      "start": 140.62,
      "end": 143.14,
      "text": "与风格化的清晰度间取得了平衡"
    },
    {
      "start": 143.14,
      "end": 145.22,
      "text": "马拉松中所有物体的比例设定"
    },
    {
      "start": 145.22,
      "end": 146.42,
      "text": "都仿佛原子"
    },
    {
      "start": 146.46,
      "end": 147.46,
      "text": "真实世界"
    },
    {
      "start": 147.46,
      "end": 148.02,
      "text": "建筑"
    },
    {
      "start": 148.02,
      "end": 149.06,
      "text": "武器与装甲"
    },
    {
      "start": 149.06,
      "end": 151.18,
      "text": "均勇有写实的尺寸比例"
    },
    {
      "start": 151.18,
      "end": 152.98,
      "text": "让人不仅将其想象为"
    },
    {
      "start": 152.98,
      "end": 154.62,
      "text": "符合物理规律的世界中"
    },
    {
      "start": 154.62,
      "end": 156.18,
      "text": "真实可用的器物"
    },
    {
      "start": 156.18,
      "end": 156.94,
      "text": "场景材质"
    },
    {
      "start": 156.94,
      "end": 158.9,
      "text": "呈现出一种克制的写实主义"
    },
    {
      "start": 158.9,
      "end": 160.42,
      "text": "在极减的视觉设计"
    },
    {
      "start": 160.42,
      "end": 162.06,
      "text": "与逼真的表面细节间"
    },
    {
      "start": 162.06,
      "end": 163.46,
      "text": "达成了平衡"
    },
    {
      "start": 163.46,
      "end": 165.38,
      "text": "这种力足现实的设计手法"
    },
    {
      "start": 165.38,
      "end": 166.82,
      "text": "让玩家放弧"
    },
    {
      "start": 166.82,
      "end": 181.12,
      "text": "置身与真实的空间之中"
    },
    {
      "start": 181.12,
      "end": 182.2,
      "text": "手指预告片发布后"
    },
    {
      "start": 182.2,
      "end": 183.24,
      "text": "马拉松的艺术总监"
    },
    {
      "start": 183.24,
      "end": 184.52,
      "text": "约瑟夫典成克洛斯"
    },
    {
      "start": 184.52,
      "end": 186.0,
      "text": "以曾参与杀球和命运"
    },
    {
      "start": 186.0,
      "end": 186.8,
      "text": "等知名项目"
    },
    {
      "start": 186.8,
      "end": 187.36,
      "text": "而主称"
    },
    {
      "start": 187.36,
      "end": 189.2,
      "text": "以及真人版功可激动队"
    },
    {
      "start": 189.2,
      "end": 190.08,
      "text": "死亡空间"
    },
    {
      "start": 190.08,
      "end": 191.84,
      "text": "和苹果留媒体聚集基地"
    },
    {
      "start": 191.84,
      "end": 193.28,
      "text": "以及诸多其他领域"
    },
    {
      "start": 193.28,
      "end": 194.72,
      "text": "他分享了灵感来源"
    },
    {
      "start": 194.72,
      "end": 196.8,
      "text": "以开发马拉松的美术风格"
    },
    {
      "start": 196.8,
      "end": 201.01,
      "text": "他产生了众多经典作品"
    },
    {
      "start": 201.01,
      "end": 202.33,
      "text": "与不同行业的元素交融"
    },
    {
      "start": 202.33,
      "end": 204.09,
      "text": "构建了游戏独特的视觉语"
    },
    {
      "start": 204.09,
      "end": 204.93,
      "text": "比如F1"
    },
    {
      "start": 204.93,
      "end": 207.29,
      "text": "塞车与摩托机批摩托车塞"
    },
    {
      "start": 207.29,
      "end": 208.89,
      "text": "在这两大顶级塞试中"
    },
    {
      "start": 208.89,
      "end": 210.33,
      "text": "每一个细节"
    },
    {
      "start": 210.33,
      "end": 213.01,
      "text": "哪怕是一处配色或材质处理"
    },
    {
      "start": 213.01,
      "end": 216.37,
      "text": "无不涨显着精准急速与高效"
    },
    {
      "start": 216.37,
      "end": 217.45,
      "text": "F1塞车"
    },
    {
      "start": 217.45,
      "end": 219.69,
      "text": "那灵力而流畅的线条"
    },
    {
      "start": 219.69,
      "end": 221.89,
      "text": "以及摩托机批机车的形态皆为硬设"
    },
    {
      "start": 221.89,
      "end": 225.05,
      "text": "与马拉松的角色与场景设计之中"
    },
    {
      "start": 225.05,
      "end": 227.53,
      "text": "正如这些在聚为极致性能而生"
    },
    {
      "start": 227.53,
      "end": 229.41,
      "text": "马拉松的高科技世界中"
    },
    {
      "start": 229.41,
      "end": 231.73,
      "text": "充斥着流线形的灵力线条"
    },
    {
      "start": 231.73,
      "end": 233.61,
      "text": "以及锐利的冷角"
    },
    {
      "start": 233.61,
      "end": 236.17,
      "text": "F1塞车与摩托机批采用"
    },
    {
      "start": 236.17,
      "end": 237.41,
      "text": "明亮醒目的配色"
    },
    {
      "start": 237.41,
      "end": 240.01,
      "text": "以提升高速行使时的辨识度"
    },
    {
      "start": 240.01,
      "end": 242.05,
      "text": "这一理念同样体现在马拉松"
    },
    {
      "start": 242.05,
      "end": 245.21,
      "text": "对尼红高光与高对比度色调的运用之中"
    },
    {
      "start": 245.21,
      "end": 246.57,
      "text": "线量的绿红蓝"
    },
    {
      "start": 246.57,
      "end": 248.89,
      "text": "较至于金属质感或深色背景之上"
    },
    {
      "start": 248.89,
      "end": 250.49,
      "text": "营造出动感十足"
    },
    {
      "start": 250.49,
      "end": 255.3,
      "text": "高燃强烈的视觉氛围"
    },
    {
      "start": 255.3,
      "end": 258.62,
      "text": "F1与摩托GP塞车的模块化设计"
    },
    {
      "start": 258.62,
      "end": 261.22,
      "text": "硬设在游戏的精妙细节中"
    },
    {
      "start": 261.22,
      "end": 263.46,
      "text": "尤其是武器与装甲的设计"
    },
    {
      "start": 263.46,
      "end": 267.1,
      "text": "似乎每个部件都成在着明确的功能指向"
    },
    {
      "start": 267.1,
      "end": 267.82,
      "text": "耐克"
    },
    {
      "start": 267.82,
      "end": 271.06,
      "text": "正如耐克的运动装备与品牌视觉风格"
    },
    {
      "start": 271.06,
      "end": 274.86,
      "text": "马拉松的视觉设计减练而严谨"
    },
    {
      "start": 274.86,
      "end": 278.06,
      "text": "耐克的设计主打功能性"
    },
    {
      "start": 278.06,
      "end": 280.54,
      "text": "这与画面所穿搭的速度与效率感"
    },
    {
      "start": 280.54,
      "end": 281.42,
      "text": "不某而合"
    },
    {
      "start": 281.42,
      "end": 282.18,
      "text": "顾佳"
    },
    {
      "start": 282.18,
      "end": 284.38,
      "text": "战役与武器显得清零"
    },
    {
      "start": 284.38,
      "end": 286.62,
      "text": "零火且专位高激动性打造"
    },
    {
      "start": 286.62,
      "end": 288.78,
      "text": "耐克一起标志性的品牌符号主称"
    },
    {
      "start": 288.78,
      "end": 291.02,
      "text": "其对图形符号的运用"
    },
    {
      "start": 291.02,
      "end": 292.78,
      "text": "与马拉松中的见面图标"
    },
    {
      "start": 292.78,
      "end": 294.66,
      "text": "及数字标记一曲同工"
    },
    {
      "start": 294.66,
      "end": 296.22,
      "text": "以及全息见面"
    },
    {
      "start": 296.22,
      "end": 297.94,
      "text": "再看功课激动队"
    },
    {
      "start": 297.94,
      "end": 300.94,
      "text": "1995年版功课激动队"
    },
    {
      "start": 301.22,
      "end": 302.3,
      "text": "为科幻题材"
    },
    {
      "start": 302.3,
      "end": 305.74,
      "text": "注入了深碎的塞伯彭克哲学美学"
    },
    {
      "start": 305.74,
      "end": 306.86,
      "text": "这种影响"
    },
    {
      "start": 306.86,
      "end": 308.98,
      "text": "以幕僚然功课激动队"
    },
    {
      "start": 308.98,
      "end": 311.58,
      "text": "融合了精密的高科技与粗广的工业质感"
    },
    {
      "start": 311.58,
      "end": 314.06,
      "text": "马拉松的未来主义拉基奥规美学"
    },
    {
      "start": 314.06,
      "end": 317.9,
      "text": "正完美呈现了这种平衡"
    },
    {
      "start": 317.9,
      "end": 319.38,
      "text": "马拉松的光影设计中"
    },
    {
      "start": 319.38,
      "end": 320.9,
      "text": "强光下的深种阴影"
    },
    {
      "start": 320.9,
      "end": 322.74,
      "text": "与奔发的迷红光效"
    },
    {
      "start": 322.74,
      "end": 324.1,
      "text": "护应了功课激动队"
    },
    {
      "start": 324.1,
      "end": 326.18,
      "text": "终层次丰富的氛围光影"
    },
    {
      "start": 326.18,
      "end": 327.5,
      "text": "营造出一种贵意"
    },
    {
      "start": 327.5,
      "end": 329.38,
      "text": "而深碎的科幻氛围"
    },
    {
      "start": 329.38,
      "end": 330.98,
      "text": "正如功课激动队"
    },
    {
      "start": 331.1,
      "end": 333.02,
      "text": "探索一体改造一半"
    },
    {
      "start": 333.02,
      "end": 335.82,
      "text": "马拉松将数字见面"
    },
    {
      "start": 335.82,
      "end": 338.74,
      "text": "与全系投影直接融入环境"
    },
    {
      "start": 338.74,
      "end": 342.42,
      "text": "构建出一个技术万无互联的世界观"
    },
    {
      "start": 342.42,
      "end": 343.42,
      "text": "披囊之下"
    },
    {
      "start": 343.42,
      "end": 346.06,
      "text": "扎开是个奇怪的灵感来源"
    },
    {
      "start": 347.06,
      "end": 348.54,
      "text": "但细细观察后"
    },
    {
      "start": 348.54,
      "end": 349.74,
      "text": "吸邏继"
    },
    {
      "start": 349.74,
      "end": 350.94,
      "text": "便以幕僚然"
    },
    {
      "start": 350.94,
      "end": 353.22,
      "text": "影片极减的不仅设计"
    },
    {
      "start": 353.22,
      "end": 354.9,
      "text": "与强烈队比同样体现在"
    },
    {
      "start": 354.9,
      "end": 356.58,
      "text": "马拉松的极减环境中"
    },
    {
      "start": 356.58,
      "end": 358.66,
      "text": "核心物件与光影"
    },
    {
      "start": 358.66,
      "end": 360.34,
      "text": "同空矿深碎的空间"
    },
    {
      "start": 360.34,
      "end": 361.74,
      "text": "形成鲜明反差"
    },
    {
      "start": 362.74,
      "end": 364.98,
      "text": "这正是涂形现实主义的"
    },
    {
      "start": 364.98,
      "end": 365.98,
      "text": "典型范例"
    },
    {
      "start": 366.98,
      "end": 368.78,
      "text": "正如我们先前探讨过的"
    },
    {
      "start": 368.78,
      "end": 369.9,
      "text": "光影在其中"
    },
    {
      "start": 369.9,
      "end": 371.34,
      "text": "质观重要"
    },
    {
      "start": 371.34,
      "end": 374.1,
      "text": "营造出即真实有超线实的氛围"
    },
    {
      "start": 375.42,
      "end": 376.54,
      "text": "披囊之下"
    },
    {
      "start": 376.54,
      "end": 378.38,
      "text": "暗示了某种意志存在"
    },
    {
      "start": 379.18,
      "end": 380.26,
      "text": "通过减约"
    },
    {
      "start": 380.26,
      "end": 381.5,
      "text": "贵意的视觉"
    },
    {
      "start": 381.5,
      "end": 384.34,
      "text": "马拉松采用了强烈的色彩对比"
    },
    {
      "start": 384.34,
      "end": 386.02,
      "text": "和视觉极减风格"
    },
    {
      "start": 386.02,
      "end": 387.7,
      "text": "营造出类似的意志"
    },
    {
      "start": 387.7,
      "end": 388.9,
      "text": "与神秘氛围"
    },
    {
      "start": 390.26,
      "end": 391.22,
      "text": "再看索尼的"
    },
    {
      "start": 391.22,
      "end": 393.54,
      "text": "PS2及早期实验性广告"
    },
    {
      "start": 394.42,
      "end": 397.34,
      "text": "尤其是90年代的那些先封作品"
    },
    {
      "start": 397.82,
      "end": 399.1,
      "text": "都以超线试"
    },
    {
      "start": 399.1,
      "end": 401.58,
      "text": "且打破常规的视觉风格文明"
    },
    {
      "start": 402.98,
      "end": 404.22,
      "text": "马拉松的设计"
    },
    {
      "start": 404.22,
      "end": 406.62,
      "text": "显然界界了这种超线试美学"
    },
    {
      "start": 407.98,
      "end": 410.3,
      "text": "以及其中那些令人废解的"
    },
    {
      "start": 410.3,
      "end": 411.3,
      "text": "梦换意向"
    },
    {
      "start": 412.14,
      "end": 414.14,
      "text": "二者都运用抽象概念"
    },
    {
      "start": 414.14,
      "end": 415.46,
      "text": "和梦境般的画面"
    },
    {
      "start": 415.94,
      "end": 417.5,
      "text": "以激发观众的好奇"
    },
    {
      "start": 417.5,
      "end": 418.5,
      "text": "与神秘感"
    },
    {
      "start": 418.74,
      "end": 419.94,
      "text": "毕竟这类景象"
    },
    {
      "start": 419.94,
      "end": 421.74,
      "text": "你可能曾在梦中见过"
    },
    {
      "start": 422.42,
      "end": 424.42,
      "text": "索尼广告长使用尖锐"
    },
    {
      "start": 424.42,
      "end": 425.86,
      "text": "冷角分明的字体"
    },
    {
      "start": 425.86,
      "end": 428.38,
      "text": "以及标志性的十字圆圈"
    },
    {
      "start": 428.38,
      "end": 429.98,
      "text": "方块与三角图形"
    },
    {
      "start": 429.98,
      "end": 431.42,
      "text": "这种风格体现在"
    },
    {
      "start": 431.42,
      "end": 433.66,
      "text": "马拉松的符号与自行系统中"
    },
    {
      "start": 434.86,
      "end": 436.66,
      "text": "这些元素强化了一种"
    },
    {
      "start": 437.06,
      "end": 439.7,
      "text": "非人的沟通感与加密语言氛围"
    },
    {
      "start": 439.7,
      "end": 442.06,
      "text": "索尼的YRK风格广告常用"
    },
    {
      "start": 442.06,
      "end": 444.66,
      "text": "深色背景配强烈状色"
    },
    {
      "start": 444.66,
      "end": 446.46,
      "text": "马拉松借此营造"
    },
    {
      "start": 447.1,
      "end": 448.54,
      "text": "未来敢与怀旧感的"
    },
    {
      "start": 448.54,
      "end": 449.98,
      "text": "焦之呼应广告"
    },
    {
      "start": 449.98,
      "end": 451.66,
      "text": "对科技前言的探索"
    },
    {
      "start": 453.26,
      "end": 454.94,
      "text": "克里斯典成看灵安"
    },
    {
      "start": 454.94,
      "end": 456.62,
      "text": "Otaker和Apex Twin"
    },
    {
      "start": 456.62,
      "end": 457.7,
      "text": "看灵安长"
    },
    {
      "start": 457.7,
      "end": 459.9,
      "text": "将生物性与机械感融合"
    },
    {
      "start": 460.74,
      "end": 462.46,
      "text": "创造出令人不安的"
    },
    {
      "start": 462.46,
      "end": 463.82,
      "text": "类赛播割形态"
    },
    {
      "start": 464.62,
      "end": 466.54,
      "text": "游戏的机械设计呈现出"
    },
    {
      "start": 466.54,
      "end": 468.26,
      "text": "人机融合的特质"
    },
    {
      "start": 468.98,
      "end": 469.66,
      "text": "酷丝"
    },
    {
      "start": 469.66,
      "end": 471.42,
      "text": "Otaker的视觉分割"
    },
    {
      "start": 471.42,
      "end": 472.74,
      "text": "顺带一提"
    },
    {
      "start": 472.74,
      "end": 473.5,
      "text": "不了了"
    },
    {
      "start": 473.5,
      "end": 475.94,
      "text": "Apex Twin的图形语言就太遗憾了"
    },
    {
      "start": 476.82,
      "end": 477.82,
      "text": "Apex"
    },
    {
      "start": 477.82,
      "end": 478.66,
      "text": "其作品"
    },
    {
      "start": 478.66,
      "end": 481.9,
      "text": "Syro采用了几件而迷换的视觉分割"
    },
    {
      "start": 481.9,
      "end": 484.7,
      "text": "配几件图案和高对比度的清凌率"
    },
    {
      "start": 485.94,
      "end": 487.46,
      "text": "正如马拉松那样"
    },
    {
      "start": 487.46,
      "end": 490.14,
      "text": "使用的等宽字体也如出意者"
    },
    {
      "start": 496.33,
      "end": 497.41,
      "text": "接下来聊聊那些"
    },
    {
      "start": 497.41,
      "end": 499.21,
      "text": "美学分割相近的作品"
    },
    {
      "start": 499.21,
      "end": 501.17,
      "text": "这些项目的视觉分割"
    },
    {
      "start": 501.17,
      "end": 502.49,
      "text": "一眼变令人连想到"
    },
    {
      "start": 502.49,
      "end": 504.29,
      "text": "马拉松禁止边缘"
    },
    {
      "start": 504.29,
      "end": 505.49,
      "text": "虽然约瑟夫典成"
    },
    {
      "start": 505.49,
      "end": 507.29,
      "text": "克洛斯曾提及这款游戏"
    },
    {
      "start": 507.29,
      "end": 508.93,
      "text": "是他回复中提到的"
    },
    {
      "start": 508.93,
      "end": 510.49,
      "text": "灵感来源之一"
    },
    {
      "start": 510.53,
      "end": 513.45,
      "text": "但其美学分割与本作更为神似"
    },
    {
      "start": 513.45,
      "end": 514.77,
      "text": "在禁止边缘里"
    },
    {
      "start": 514.77,
      "end": 517.21,
      "text": "我们能看到一个进乎显示的城市场景"
    },
    {
      "start": 517.21,
      "end": 518.93,
      "text": "因鲜明的色彩点粹"
    },
    {
      "start": 518.93,
      "end": 520.53,
      "text": "而更具张力"
    },
    {
      "start": 520.53,
      "end": 523.05,
      "text": "纯净的白色建筑如同画布"
    },
    {
      "start": 523.05,
      "end": 526.57,
      "text": "大胆铺沉着红、成、蓝、等亮色"
    },
    {
      "start": 526.57,
      "end": 527.73,
      "text": "营造出一种"
    },
    {
      "start": 527.73,
      "end": 530.25,
      "text": "技术系又具未来感的氛围"
    },
    {
      "start": 530.25,
      "end": 531.45,
      "text": "正如马拉松"
    },
    {
      "start": 531.45,
      "end": 533.85,
      "text": "他利用色彩引导视觉焦点"
    },
    {
      "start": 533.85,
      "end": 535.89,
      "text": "突出关键元素"
    },
    {
      "start": 535.89,
      "end": 539.41,
      "text": "在减约设计与强烈视觉冲击间取得平衡"
    },
    {
      "start": 539.41,
      "end": 542.57,
      "text": "The Finals也呈现出类似的美学分割"
    },
    {
      "start": 542.57,
      "end": 546.45,
      "text": "场景灵感源自真实世界的建筑结构"
    },
    {
      "start": 546.45,
      "end": 549.73,
      "text": "却注入了先活色彩与精致质感"
    },
    {
      "start": 549.73,
      "end": 552.17,
      "text": "变平冷角表面搭配"
    },
    {
      "start": 552.17,
      "end": 554.13,
      "text": "明亮极简的符号突浮"
    },
    {
      "start": 554.13,
      "end": 555.41,
      "text": "营造出超线时"
    },
    {
      "start": 555.41,
      "end": 557.61,
      "text": "却有扎根线时的独特氛围奔作"
    },
    {
      "start": 557.61,
      "end": 559.17,
      "text": "延续了马拉松的偏爱"
    },
    {
      "start": 559.17,
      "end": 562.33,
      "text": "即减结高对比视觉与大胆图形元素"
    },
    {
      "start": 562.33,
      "end": 565.57,
      "text": "同时赋予设计充满活力的现代气息"
    },
    {
      "start": 565.57,
      "end": 569.09,
      "text": "Republic工作室在反重力赛车中的作品"
    },
    {
      "start": 569.09,
      "end": 571.37,
      "text": "万如千喜年的时光教党"
    },
    {
      "start": 571.37,
      "end": 574.29,
      "text": "看成游戏中此类分割的标志性典范"
    },
    {
      "start": 574.29,
      "end": 576.73,
      "text": "Republic工作室在反重力赛车中"
    },
    {
      "start": 576.73,
      "end": 578.93,
      "text": "融合了流线型的未来主义元素"
    },
    {
      "start": 578.93,
      "end": 581.69,
      "text": "并着重打造品牌标实"
    },
    {
      "start": 581.69,
      "end": 584.45,
      "text": "即合拍板与充满活力的配色"
    },
    {
      "start": 584.45,
      "end": 585.77,
      "text": "反重力赛车的成功"
    },
    {
      "start": 585.77,
      "end": 588.93,
      "text": "源于其在未来写试与分割画之间的微妙平衡"
    },
    {
      "start": 588.93,
      "end": 590.33,
      "text": "游戏中的素材与环境"
    },
    {
      "start": 590.33,
      "end": 592.29,
      "text": "均经过了几句张力的艺术体列"
    },
    {
      "start": 592.29,
      "end": 594.89,
      "text": "马拉松大量运用几件分割的标志"
    },
    {
      "start": 594.89,
      "end": 597.93,
      "text": "与本事设计延续了这一设计卖落"
    },
    {
      "start": 597.93,
      "end": 602.21,
      "text": "时期深深扎根与大胆图形实验的历史基点中"
    },
    {
      "start": 602.21,
      "end": 604.93,
      "text": "以音频设备与合成器创新"
    },
    {
      "start": 604.93,
      "end": 607.25,
      "text": "设计驻成的T&H Engineering"
    },
    {
      "start": 607.25,
      "end": 611.13,
      "text": "建训了功能极减主义理念"
    },
    {
      "start": 611.13,
      "end": 612.85,
      "text": "建议先活的美学风格"
    },
    {
      "start": 612.85,
      "end": 615.73,
      "text": "期待表做如OP1合成器"
    },
    {
      "start": 615.73,
      "end": 619.89,
      "text": "融合了精致的副股界面与零动的色彩运用"
    },
    {
      "start": 619.89,
      "end": 623.53,
      "text": "这一理念与马拉松推崇的图形现实主义"
    },
    {
      "start": 623.53,
      "end": 624.53,
      "text": "高度契合"
    },
    {
      "start": 624.53,
      "end": 626.41,
      "text": "尤其在武器设计上"
    },
    {
      "start": 626.41,
      "end": 629.53,
      "text": "功能性与大胆设计表达的平衡成为焦点"
    },
    {
      "start": 631.13,
      "end": 633.53,
      "text": "两者均采用实用主义路径"
    },
    {
      "start": 633.53,
      "end": 636.17,
      "text": "并以鲜明的图形设计加以升华"
    },
    {
      "start": 636.17,
      "end": 640.01,
      "text": "将实用功能与极军冲击力的视觉形象完美融合"
    },
    {
      "start": 640.01,
      "end": 641.61,
      "text": "Made a Haven的作品"
    },
    {
      "start": 641.61,
      "end": 644.93,
      "text": "这家以实验性视觉设计文明的工作室"
    },
    {
      "start": 644.93,
      "end": 647.65,
      "text": "新美学理念与马拉松高度契合"
    },
    {
      "start": 647.65,
      "end": 650.81,
      "text": "尤其是参考ARG中的Mitazine这一案例"
    },
    {
      "start": 651.81,
      "end": 656.01,
      "text": "便能直观感受到那种叛逆且进乎割裂的风格"
    },
    {
      "start": 656.01,
      "end": 658.61,
      "text": "碎变化的拼铁排版"
    },
    {
      "start": 658.61,
      "end": 661.01,
      "text": "高保和色彩与饮会训细"
    },
    {
      "start": 661.01,
      "end": 663.41,
      "text": "张显出一种颠覆传统的张力"
    },
    {
      "start": 663.41,
      "end": 666.01,
      "text": "两者军兵器传统规范"
    },
    {
      "start": 666.01,
      "end": 669.41,
      "text": "可以营造破碎而挑衅的视觉体验"
    },
    {
      "start": 669.41,
      "end": 673.41,
      "text": "引导观众进行解读并沉浸于这份混顿之中"
    },
    {
      "start": 673.41,
      "end": 675.61,
      "text": "并依靠推动平面设计"
    },
    {
      "start": 675.61,
      "end": 679.21,
      "text": "的常规走向充满未来感与些许混顿的方向"
    },
    {
      "start": 679.21,
      "end": 681.41,
      "text": "富裕其一种原始的质感"
    },
    {
      "start": 681.41,
      "end": 684.21,
      "text": "马拉松深度融合了粗业主义设计风格"
    },
    {
      "start": 684.21,
      "end": 685.61,
      "text": "涵盖其宣传无料"
    },
    {
      "start": 685.61,
      "end": 687.61,
      "text": "官网机品牌视觉"
    },
    {
      "start": 687.61,
      "end": 689.81,
      "text": "视觉上以高保和度的"
    },
    {
      "start": 689.81,
      "end": 692.21,
      "text": "近似泥洪的亮色与黑色或中心背景"
    },
    {
      "start": 692.21,
      "end": 693.61,
      "text": "形成强烈反差"
    },
    {
      "start": 693.61,
      "end": 697.21,
      "text": "营造出几句冲击力且略带激进的视觉张力"
    },
    {
      "start": 697.21,
      "end": 701.01,
      "text": "粗业主义平面设计彻底抛弃传统网格"
    },
    {
      "start": 701.01,
      "end": 704.41,
      "text": "拥抱打破常规甚至充满冲突感的布局"
    },
    {
      "start": 704.41,
      "end": 707.21,
      "text": "其设计借鉴了建筑粗业主义"
    },
    {
      "start": 707.21,
      "end": 711.01,
      "text": "推崇原始不加修饰且极致使用的美学风格"
    },
    {
      "start": 711.01,
      "end": 713.21,
      "text": "庞采用极监网格布局"
    },
    {
      "start": 714.21,
      "end": 716.81,
      "text": "大胆拍板及克制的配色方案"
    },
    {
      "start": 716.81,
      "end": 719.41,
      "text": "盖风格刻意柄气精雕细着"
    },
    {
      "start": 719.41,
      "end": 721.61,
      "text": "只为回归纯粹的功能性"
    },
    {
      "start": 721.61,
      "end": 724.81,
      "text": "呈现出粗广而物实的视觉质感"
    },
    {
      "start": 724.81,
      "end": 725.91,
      "text": "通过高反差"
    },
    {
      "start": 725.91,
      "end": 729.41,
      "text": "超大字号与相苏化处理配合粗重的图标符号"
    },
    {
      "start": 729.41,
      "end": 737.81,
      "text": "只在大噪一种兼具复古于冷均现代感的独特视觉"
    },
    {
      "start": 737.81,
      "end": 738.81,
      "text": "在总结之前"
    },
    {
      "start": 738.81,
      "end": 740.61,
      "text": "我想抛出一个关键问题"
    },
    {
      "start": 742.21,
      "end": 744.01,
      "text": "这还是马拉松吗"
    },
    {
      "start": 744.01,
      "end": 745.61,
      "text": "新作是否配得上"
    },
    {
      "start": 745.61,
      "end": 747.81,
      "text": "严用原作三部曲之名"
    },
    {
      "start": 747.81,
      "end": 751.01,
      "text": "毕竟该系列即将迎来30周年"
    },
    {
      "start": 751.61,
      "end": 753.21,
      "text": "答案其实很简单"
    },
    {
      "start": 753.21,
      "end": 754.81,
      "text": "碎费螢幕了然"
    },
    {
      "start": 754.81,
      "end": 756.01,
      "text": "但答案是肯定的"
    },
    {
      "start": 756.01,
      "end": 757.81,
      "text": "他依然是马拉松"
    },
    {
      "start": 757.81,
      "end": 759.21,
      "text": "新作在探索上"
    },
    {
      "start": 759.21,
      "end": 760.61,
      "text": "卖出了大胆的一步"
    },
    {
      "start": 760.61,
      "end": 763.81,
      "text": "同时始终怀穿着对本源的深切敬意"
    },
    {
      "start": 763.81,
      "end": 765.01,
      "text": "例如剪约"
    },
    {
      "start": 765.01,
      "end": 766.81,
      "text": "却充满力量的logo"
    },
    {
      "start": 766.81,
      "end": 769.01,
      "text": "便直接致敬了原作"
    },
    {
      "start": 769.01,
      "end": 770.61,
      "text": "尽管经过现代化重塑"
    },
    {
      "start": 770.61,
      "end": 772.01,
      "text": "拥有更丰历的冷角"
    },
    {
      "start": 772.01,
      "end": 773.01,
      "text": "取代了"
    },
    {
      "start": 773.01,
      "end": 775.21,
      "text": "就版的原论线条"
    },
    {
      "start": 775.21,
      "end": 776.81,
      "text": "但其标志性轮廓"
    },
    {
      "start": 776.81,
      "end": 779.41,
      "text": "与独特神运依然如故"
    },
    {
      "start": 779.41,
      "end": 780.41,
      "text": "这一眼变"
    },
    {
      "start": 780.41,
      "end": 782.81,
      "text": "玩如连接两个时代的悄良"
    },
    {
      "start": 782.81,
      "end": 784.61,
      "text": "即致敬系列起源"
    },
    {
      "start": 784.61,
      "end": 786.01,
      "text": "又融合了更利落"
    },
    {
      "start": 786.01,
      "end": 787.81,
      "text": "更具当代感的美学风格"
    },
    {
      "start": 787.81,
      "end": 788.81,
      "text": "调温图案是"
    },
    {
      "start": 788.81,
      "end": 791.41,
      "text": "马拉松视觉风格的标志性元素"
    },
    {
      "start": 791.41,
      "end": 793.01,
      "text": "在新作的图形元中"
    },
    {
      "start": 793.01,
      "end": 795.21,
      "text": "这些元素同样无处不在"
    },
    {
      "start": 795.21,
      "end": 796.81,
      "text": "无论出现在环境贴图"
    },
    {
      "start": 796.81,
      "end": 798.41,
      "text": "还是极限于外中"
    },
    {
      "start": 798.41,
      "end": 801.21,
      "text": "这是一种巧妙而有效的致敬"
    },
    {
      "start": 801.21,
      "end": 804.61,
      "text": "针对早期受技术限制的设计美学"
    },
    {
      "start": 804.61,
      "end": 806.81,
      "text": "这些图案绝非单纯的装饰"
    },
    {
      "start": 806.81,
      "end": 807.81,
      "text": "而是定义"
    },
    {
      "start": 807.81,
      "end": 810.41,
      "text": "马拉松核心特质的基因密码"
    },
    {
      "start": 810.41,
      "end": 811.81,
      "text": "此外还有内具标语"
    },
    {
      "start": 811.81,
      "end": 813.41,
      "text": "Somewhere in the heavens"
    },
    {
      "start": 813.41,
      "end": 815.41,
      "text": "全部采用小写字母"
    },
    {
      "start": 815.41,
      "end": 817.61,
      "text": "正如新马拉松官网的其他内容一样"
    },
    {
      "start": 817.61,
      "end": 818.81,
      "text": "这种刻意的"
    },
    {
      "start": 818.81,
      "end": 820.01,
      "text": "自体设计"
    },
    {
      "start": 820.01,
      "end": 822.01,
      "text": "营造出一种低调的自信"
    },
    {
      "start": 822.01,
      "end": 823.41,
      "text": "将游戏的视觉标事"
    },
    {
      "start": 823.41,
      "end": 825.41,
      "text": "与其红大的世界观融为一体"
    },
    {
      "start": 825.41,
      "end": 828.21,
      "text": "这一细为全耐人寻为的细节展现了"
    },
    {
      "start": 828.21,
      "end": 830.61,
      "text": "马拉松如何在对经典的致敬"
    },
    {
      "start": 830.61,
      "end": 834.21,
      "text": "与经质的现代审美间取得平衡"
    },
    {
      "start": 834.21,
      "end": 836.61,
      "text": "新作中更具粗利质感的概念艺术"
    },
    {
      "start": 836.61,
      "end": 837.41,
      "text": "也让人想起"
    },
    {
      "start": 837.41,
      "end": 839.41,
      "text": "克勒格典成沐林斯的作品"
    },
    {
      "start": 839.41,
      "end": 840.81,
      "text": "他急剧前占信的话做"
    },
    {
      "start": 840.81,
      "end": 843.41,
      "text": "奠定了初代三部曲的大部分氛围"
    },
    {
      "start": 843.41,
      "end": 844.41,
      "text": "积调"
    },
    {
      "start": 844.41,
      "end": 846.61,
      "text": "那种红大与神秘质感"
    },
    {
      "start": 846.61,
      "end": 847.61,
      "text": "沐林斯比下"
    },
    {
      "start": 847.61,
      "end": 850.21,
      "text": "那种红大神秘与紧崩的氛围"
    },
    {
      "start": 850.21,
      "end": 852.21,
      "text": "在新作马拉松中得以延续"
    },
    {
      "start": 852.21,
      "end": 853.81,
      "text": "这绝非巧合"
    },
    {
      "start": 853.81,
      "end": 855.81,
      "text": "而是有意为之旨在"
    },
    {
      "start": 856.01,
      "end": 857.41,
      "text": "将那份精神内合"
    },
    {
      "start": 857.41,
      "end": 859.61,
      "text": "为新生代重新演艺"
    },
    {
      "start": 859.61,
      "end": 863.41,
      "text": "而目前所见这些相似之处"
    },
    {
      "start": 863.41,
      "end": 864.61,
      "text": "不过是开发者"
    },
    {
      "start": 864.61,
      "end": 867.01,
      "text": "聊聊数与透露出的冰山一角"
    },
    {
      "start": 867.01,
      "end": 869.41,
      "text": "本作依旧例如粉丝熟悉"
    },
    {
      "start": 869.41,
      "end": 871.61,
      "text": "并终爱的同意世界观"
    },
    {
      "start": 871.61,
      "end": 872.81,
      "text": "并在原有基础上"
    },
    {
      "start": 872.81,
      "end": 874.81,
      "text": "尽以不妥寬了故事版图"
    },
    {
      "start": 874.81,
      "end": 877.41,
      "text": "尽管画面表现力依然谨话"
    },
    {
      "start": 877.41,
      "end": 878.81,
      "text": "但对经典三部曲的情怀"
    },
    {
      "start": 878.81,
      "end": 880.41,
      "text": "却渗透在每一个细节之中"
    },
    {
      "start": 880.41,
      "end": 881.81,
      "text": "我们以偏见那些急剧"
    },
    {
      "start": 881.81,
      "end": 883.41,
      "text": "标志性的系统价格设计"
    },
    {
      "start": 883.41,
      "end": 885.01,
      "text": "以及背售追捧的"
    },
    {
      "start": 885.01,
      "end": 887.21,
      "text": "马拉松自动防御无人机"
    },
    {
      "start": 887.21,
      "end": 889.21,
      "text": "我们大概率会歇候"
    },
    {
      "start": 889.21,
      "end": 890.61,
      "text": "更多经典元素"
    },
    {
      "start": 890.61,
      "end": 892.21,
      "text": "伴随游戏进程的展开"
    },
    {
      "start": 892.21,
      "end": 893.61,
      "text": "说到底新马拉松"
    },
    {
      "start": 893.61,
      "end": 895.81,
      "text": "绝非仅仅是一次重置"
    },
    {
      "start": 895.81,
      "end": 897.61,
      "text": "他是正统序座"
    },
    {
      "start": 897.61,
      "end": 900.41,
      "text": "寄传承了前作精髓"
    },
    {
      "start": 900.41,
      "end": 902.61,
      "text": "又大胆开闭了全新疆域"
    },
    {
      "start": 902.61,
      "end": 903.81,
      "text": "在官方正式中"
    },
    {
      "start": 903.81,
      "end": 906.81,
      "text": "马拉松同样引入了多元事件现设定"
    },
    {
      "start": 907.61,
      "end": 909.01,
      "text": "这部新作"
    },
    {
      "start": 909.01,
      "end": 912.21,
      "text": "似乎能无奉容如该世界观框架"
    }
  ]
}